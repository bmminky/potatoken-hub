<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon, which WPF has no equivalent of. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>potatoken hub</AssemblyName>
    <RootNamespace>PotatokenHub</RootNamespace>
    <Version>1.5.0</Version>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\AppIcon.ico" Condition="Exists('Resources\AppIcon.ico')" />
    <Resource Include="Resources\AppIcon.ico" Condition="Exists('Resources\AppIcon.ico')" />
  </ItemGroup>

</Project>
