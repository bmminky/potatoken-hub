<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon, which WPF has no equivalent of. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>potatoken hub</AssemblyName>
    <RootNamespace>PotatokenHub</RootNamespace>
    <Version>1.17.0</Version>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these globally, which makes Color, Size, Panel and
         HorizontalAlignment ambiguous against their WPF namesakes in every file.
         The two files that need WinForms/GDI import them explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\AppIcon.ico" Condition="Exists('Resources\AppIcon.ico')" />
    <Resource Include="Resources\AppIcon.ico" Condition="Exists('Resources\AppIcon.ico')" />
  </ItemGroup>

</Project>
