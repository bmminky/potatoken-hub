<Window x:Class="PotatokenHub.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="potatoken hub"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        MinWidth="180" MinHeight="90"
        Width="300" Height="250">

    <Border x:Name="Card"
            Margin="16"
            CornerRadius="10"
            Background="#E61E1E20"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <!-- Large tier: per-window gauges, reset times, footer. -->
            <StackPanel x:Name="LargeView" Margin="16,16,16,14" Visibility="Collapsed">
                <StackPanel x:Name="LargeClaude" />
                <Separator x:Name="LargeProviderSeparator" Margin="0,10" Background="#33FFFFFF" />
                <StackPanel x:Name="LargeCodex" />
                <StackPanel x:Name="LargeEmpty" Visibility="Collapsed">
                    <TextBlock Text="potatoken hub" Foreground="#99FFFFFF"
                               FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Separator Margin="0,10" Background="#33FFFFFF" />
                <Grid>
                    <TextBlock x:Name="UpdatedText"
                               Foreground="#99FFFFFF" FontSize="10"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Content="⟳" Width="26" Height="22"
                                Margin="0,0,6,0" Click="OnRefreshClick" />
                        <Button x:Name="HideButton" Content="✕" Width="26" Height="22"
                                Click="OnHideClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Small tier: one summary row per provider. -->
            <StackPanel x:Name="SmallView" Margin="10,9,10,11">
                <StackPanel x:Name="SmallClaude" Margin="0,0,0,7" />
                <StackPanel x:Name="SmallCodex" />
                <TextBlock x:Name="SmallEmpty" Text="potatoken hub"
                           Visibility="Collapsed" Foreground="#99FFFFFF"
                           FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
